# =============================================================
#  HR Platform – Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit the actual .env file.
# =============================================================

# ─────────────────────────────────────────────
# PostgreSQL Database
# ─────────────────────────────────────────────
# Full JDBC URL. When using Docker Compose the host should be "db".
# For a local install use "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrplatform
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password

# ─────────────────────────────────────────────
# Spring Boot Server
# ─────────────────────────────────────────────
SERVER_PORT=8080

# ─────────────────────────────────────────────
# Mail / SMTP  (Gmail example)
# Use an App Password, NOT your Google account password.
# Generate at: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# ─────────────────────────────────────────────
# RapidAPI – LinkedIn Job Search
# Get your key at: https://rapidapi.com/hub
# ─────────────────────────────────────────────
RAPIDAPI_JOBS_HOST=linkedin-job-search-api.p.rapidapi.com
RAPIDAPI_JOBS_KEY=your_rapidapi_key_here

# ─────────────────────────────────────────────
# Admin Seed Account  (used by DataInitializer)
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# ─────────────────────────────────────────────
# Frontend (Vite)
# ─────────────────────────────────────────────
# Exposed to the browser – do NOT put secrets here.
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=3000
